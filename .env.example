APP_NAME=monitor-system
APP_ENV=dev

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=monitor_db
MYSQL_ROOT_PASSWORD=123456

JWT_SECRET_KEY=change-this-in-production
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456

AI_WORKER_USERNAME=ai_worker
AI_WORKER_PASSWORD=ai_pass666
API_BASE_URL=http://127.0.0.1:8000

# Supported roles: admin, operator, viewer, ai_worker.
# The default bootstrap creates admin and ai_worker. Additional users can be inserted into users table.
